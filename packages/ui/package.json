{
  "name": "@teko/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design system Teko en code — tokens générés depuis design-tokens.json (source d'autorité) + kit de composants React Native (./native) fidèle aux maquettes components/.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./native": "./src/native/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "gen:tokens": "node scripts/generate-tokens.mjs"
  },
  "devDependencies": {
    "@teko/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/react": "~19.2.0",
    "expo-linear-gradient": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-svg": "15.15.4"
  },
  "peerDependencies": {
    "expo-linear-gradient": "*",
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*"
  }
}
