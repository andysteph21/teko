{
  "name": "@teko/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design system Teko en code — tokens générés depuis docs/design/design-tokens.json (source d'autorité), composants RN à venir avec les écrans (lot 3).",
  "type": "module",
