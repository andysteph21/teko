{
  "name": "@teko/config",
  "version": "0.0.0",
  "private": true,
  "description": "Configurations TypeScript partagées du monorepo Teko. Lint & format : Biome, configuré à la racine du dépôt (biome.json).",
  "type": "module",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./tsconfig/react-native.json": "./tsconfig/react-native.json",
    "./tsconfig/react-library.json": "./tsconfig/react-library.json"
  },
  "files": [
    "tsconfig"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
