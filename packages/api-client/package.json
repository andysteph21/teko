{
  "name": "@teko/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Client API Teko — SEUL point de contact des apps avec Supabase (doc 10 §3) : client typé, enveloppes RPC par domaine, mapper d'erreurs, canal de positions (ADR-13).",
