  "dependencies": {
    "@supabase/supabase-js": "catalog:",
    "@teko/maps": "workspace:*",
    "@teko/types": "workspace:*"
  },
  "devDependencies": {
    "@teko/config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
