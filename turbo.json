{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.json", ".npmrc"],
  "globalPassThroughEnv": ["EXPO_ACCESS_TOKEN"],
  "globalEnv": [
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_DB_URL",
    "API_URL",
    "ANON_KEY",
    "SERVICE_ROLE_KEY",
    "DB_URL",
    "DATABASE_URL",
    "CI",
    "EXPO_PUBLIC_ALPHA_USB_GPS",
    "EXPO_PUBLIC_SUPABASE_URL",
    "EXPO_PUBLIC_SUPABASE_ANON_KEY",
    "EXPO_PUBLIC_TILES_URL",
    "EXPO_PUBLIC_VALHALLA_URL",
    "TEKO_APP_VARIANT",
    "TEKO_ALLOW_LOCAL_HTTP",
    "TEKO_EXPO_OWNER",
    "TEKO_GOOGLE_SERVICES_FILE",
    "EXPO_PUBLIC_EAS_PROJECT_ID",
    "TEKO_E2E_DISPOSABLE",
    "TEKO_FUNCTIONS_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY"
  ],
  "tasks": {
    "//#lint": {
      "inputs": ["**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}", "biome.json", "**/biome.json"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "DATABASE_URL",
        "CI"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
