# Résolution adaptée au monorepo Expo/React Native + Next.js.
# node-linker=hoisted : recommandé pour Expo/Metro qui supportent mal les
# symlinks pnpm stricts (à conserver tant que les apps mobiles sont présentes).
node-linker=hoisted
# Les peer deps RN/Expo sont nombreuses et parfois imprécises : on les installe
# automatiquement sans bloquer l'install.
auto-install-peers=true
strict-peer-dependencies=false
# Expo/Metro ont besoin d'accéder aux binaires hissés.
shamefully-hoist=true
