{
  "name": "teko",
  "private": true,
  "version": "0.0.0",
  "description": "Teko — super-app de services urbains au Gabon (MVP ride-hailing). Monorepo.",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build --concurrency=1",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck --concurrency=2",
    "test": "turbo run test --concurrency=2",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules",
    "gen:types": "supabase gen types typescript --local > packages/types/src/database.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "^2.7.0",
    "typescript": "catalog:",
    "@react-native/metro-config": "0.86.2",
    "react-dom": "19.2.3",
    "react": "19.2.3"
  }
}
